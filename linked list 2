}

/* 8. Merge another list into current list (avoid duplicates by ID) */
void merge_employees(Employee* list2_head) {
    Employee* temp = list2_head;
    while (temp) {
        if (!id_exists(temp->id)) {
            Employee* newEmp = create_employee(temp->name, temp->id, temp->manager, temp->rank);
            // append
            if (head == NULL) head = newEmp;
            else {
                Employee* last = head;
                while (last->next) last = last->next;
                last->next = newEmp;
            }
        } else {
            printf("Skipped duplicate ID %d (%s)\n", temp->id, temp->name);
        }
        temp = temp->next;
    }
    printf("Merge completed.\n");
}

/* 9. Compare hierarchy with another list (based on average rank) */
int compare_employees(Employee* list2_head) {
    if (head == NULL && list2_head == NULL) return 0;
    int totalRank1 = 0, totalRank2 = 0;
    int count1 = 0, count2 = 0;
    Employee* t = head;
    while (t) { totalRank1 += t->rank; count1++; t = t->next; }
    t = list2_head;
    while (t) { totalRank2 += t->rank; count2++; t = t->next; }
    double avg1 = (count1 == 0) ? 0 : (double)totalRank1 / count1;
    double avg2 = (count2 == 0) ? 0 : (double)totalRank2 / count2;
    if (avg1 < avg2) return 1;   // current list has higher hierarchy (lower rank number)
    else if (avg1 > avg2) return -1;
    else return 0;
}

/* 10. Count employees */
int count_employees() {
    int cnt = 0;
    Employee* temp = head;
    while (temp) { cnt++; temp = temp->next; }
    return cnt;
}

/* 11. Check if list empty */
int is_employee_list_empty() {
    return head == NULL;
}

/* 12. Delete entire list */
void delete_employee_list() {
    Employee* temp;
    while (head) {
        temp = head;
        head = head->next;
        free(temp);
    }
    printf("All employees deleted.\n");
}

/* 13. Get manager name of an employee by ID */
char* get_employee_manager(int id) {
    Employee* emp = find_by_id(id);
    if (emp) return emp->manager;
    return NULL;
}

/* 14. Get name of employee by ID */
char* get_employee_name(int id) {
    Employee* emp = find_by_id(id);
    if (emp) return emp->name;
    return NULL;
}

/* 15. Get employee ID by index (0‑based) – the requested function name is kept,
       but it returns the ID at given index; if index is invalid, returns -1 */
int get_employee_id(int index) {
    Employee* temp = head;
    int i = 0;
    while (temp) {
        if (i == index) return temp->id;
        i++;
        temp = temp->next;
    }
    return -1;
}

/* Additional search functions: by name and by index */
void search_by_name(char* name) {
    Employee* emp = find_by_name(name);
    if (emp) {
        printf("Found: Name=%s, ID=%d, Manager=%s, Rank=%d\n", emp->name, emp->id, emp->manager, emp->rank);
    } else {
        printf("Employee with name '%s' not found.\n", name);
    }
}

void search_by_index(int index) {
    Employee* temp = head;
    int i = 0;
    while (temp) {
        if (i == index) {
            printf("At index %d: Name=%s, ID=%d, Manager=%s, Rank=%d\n", index, temp->name, temp->id, temp->manager, temp->rank);
            return;
        }
        i++;
        temp = temp->next;
    }
    printf("Index %d out of range.\n", index);
}

/* Inversion: reverse the linked list */
void reverse_list() {
    Employee* prev = NULL;
    Employee* curr = head;
    Employee* next = NULL;
    while (curr) {
        next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
    }
    head = prev;
    printf("List reversed.\n");
}

/* Verification: check for duplicate IDs and valid manager references */
int verify_list() {
    if (head == NULL) return 1;
    Employee* outer = head;
    while (outer) {
        // duplicate check
        Employee* inner = outer->next;
        while (inner) {
            if (outer->id == inner->id) {
                printf("Verification failed: duplicate ID %d (%s and %s)\n", outer->id, outer->name, inner->name);
                return 0;
            }
            inner = inner->next;
        }
        // manager existence check (if manager not empty and not self)
        if (strlen(outer->manager) > 0 && strcmp(outer->name, outer->manager) != 0) {
            if (!find_by_name(outer->manager)) {
                printf("Verification warning: manager '%s' for employee '%s' does not exist.\n", outer->manager, outer->name);
                // not a failure, just warning
            }
        }
        outer = outer->next;
    }
    printf("Verification passed (no duplicate IDs).\n");
    return 1;
}



